{
  "name": "openbuff",
  "version": "1.0.682",
  "description": "Openbuff - AI coding agent",
  "license": "MIT",
  "bin": {
    "openbuff": "index.js",
    "ob": "index.js"
  },
  "scripts": {
    "postinstall": "node postinstall.js",
    "preuninstall": "node -e \"const fs = require(\"fs\"); const path = require(\"path\"); const os = require(\"os\"); const binaryPath = path.join(os.homedir(), \".config\", \"manicode\", process.platform === \"win32\" ? \"openbuff.exe\" : \"openbuff\"); try { fs.unlinkSync(binaryPath) } catch (e) { /* ignore */ }\""
  },
  "files": [
    "index.js",
    "http.js",
    "postinstall.js",
    "README.md"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "tar": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CodebuffAI/codebuff.git"
  },
  "homepage": "https://openbuff.dev",
  "publishConfig": {
    "access": "public"
  }
}